# Client-safe value. Only variables prefixed with NEXT_PUBLIC_ are bundled for browsers.
NEXT_PUBLIC_APP_ENV=development

# Supabase browser-safe project configuration (required for authentication).
# Use the publishable key, never a service_role key.
#
# This single variable is the auth host for the whole app: every Supabase client
# (browser, server, admin, middleware CSP and the scripts/ CLIs) is built from
# it, so changing it here moves all of them together. No project ref is hard
# coded anywhere — src/config/env/supabase-host.test.ts fails the build if one
# is reintroduced.
#
# Two accepted shapes:
#   https://<project-ref>.supabase.co   default; Google's account chooser then
#                                       reads "continue to <project-ref>.supabase.co"
#   https://auth.<owned-domain>         Supabase Custom Domain add-on; Google
#                                       then shows the owned domain instead
#
# Switching to the second shape is a configuration change only, but it is NOT
# complete until the Google OAuth client's authorized redirect URI is updated to
# https://auth.<owned-domain>/auth/v1/callback. Full checklist:
#   docs/auth/google-oauth-branding.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only optional integrations.
# Never prefix secrets with NEXT_PUBLIC_ and never commit real credentials.
# Used only on the server for Thai Company Profile translation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional. Overrides the model for the News tab's AI summary only; leave unset
# to keep it on GEMINI_MODEL. Set it to move that one feature — a larger model,
# or a pin that holds it still while the translator moves.
GEMINI_NEWS_MODEL=
# Server-only provider for quotes, profile, OHLCV, financial statements, and
# Analyst Consensus fallback via OVERVIEW.AnalystTargetPrice.
ALPHA_VANTAGE_API_KEY=
# Server-only Financial Modeling Prep provider for existing market-data and
# fundamentals fallbacks. Analyst Consensus does not depend on FMP.
FMP_API_KEY=
# Server-only primary Analyst Consensus provider via stock/price-target.
FINNHUB_API_KEY=
# Required to enable the keyless SEC Company Facts/XBRL cold-start fallback.
# SEC asks automated clients to identify an organization and contact email.
SEC_USER_AGENT=Nexora AI ops@example.com
# Primary production provider for stock quote, OHLCV, and exchange session data.
# MARKET_DATA_PROVIDER currently accepts only "polygon" when configured.
POLYGON_API_KEY=
MARKET_DATA_PROVIDER=polygon
# Alpaca credentials. Required by the market Gateway (Railway) AND, since the
# options provider migration, by the Next.js app itself (Vercel): Alpaca is the
# only configured provider entitled to real options contracts and open interest.
# Without these, /api/market/options reports a truthful entitlement failure.
# Verify with: npm run probe:options-providers
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Alpaca serves the options contracts catalogue from the Trading API. Paper and
# live hosts expose the same catalogue; leave empty to use the paper host, and
# set https://api.alpaca.markets only for live trading credentials.
ALPACA_TRADING_BASE_URL=
# Server-only NewsAPI credential. Configure this exact name in each Vercel
# environment that should serve /api/news; market-data keys are not reused.
NEWS_API_KEY=
# Server-only Upstash Redis, the shared cache behind the News tab's AI summary.
# One summary per symbol is generated and every reader of that symbol is served
# the same bytes, so this cache must outlive a single serverless instance —
# there is no in-process fallback. Leave these unset to ship the News tab without
# the summary card; articles are unaffected. GEMINI_API_KEY above is the other
# half: the card needs both.
#
# Set ONE pair, not both. KV_REST_API_* is what Vercel's Upstash integration
# writes into a linked project, so on Vercel these appear on their own and
# nothing below needs filling in. UPSTASH_REDIS_REST_* is Upstash's own naming,
# which is what you get copying credentials out of the Upstash console for local
# work or a non-Vercel host. The app reads the KV_ pair first and falls back to
# the UPSTASH_ pair; a URL without its token (or the reverse) counts as unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Finnhub live trade stream (server-only, Railway Gateway only) ---
# FINNHUB_API_KEY above is reused by the standalone Gateway. The browser never
# connects to Finnhub and never receives this secret. Never create a
# NEXT_PUBLIC_FINNHUB_API_KEY variable.
# Master switch for the Gateway. When false or unset, the app stays on REST polling.
MARKET_REALTIME_ENABLED=false
# Client-safe URL of the deployed Gateway service the browser subscribes to,
# e.g. wss://market-gateway.example.com/ws. This is NOT a secret. Leave blank to
# keep the browser on REST polling. Serverless/Vercel route handlers cannot host
# this persistent socket — deploy the Gateway as its own long-lived Node service.
# Set this in Vercel (Production) so the middleware CSP allows the wss:// origin.
# LOCAL dev must point at the LOCAL Gateway (ws://localhost:8081/ws), never at the
# deployed one: the deployed Gateway's allow-list holds only the canonical site
# origin, so a loopback Origin is rejected with 403 and the app falls back to REST.
NEXT_PUBLIC_MARKET_WS_URL=
# --- Gateway host only (Railway) + local dev, NOT Vercel ---
# Comma-separated browser origins allowed to open the Gateway /ws endpoint, e.g.
# https://app.example.com,https://staging.example.com. Required in production, and
# it must list ONLY the canonical site origin(s) — a per-deployment preview URL or
# a loopback origin does not belong in the deployed Gateway's allow-list.
# Also required for LOCAL dev: `npm run gateway` runs with NODE_ENV unset (not
# "development"), so localhost is NOT auto-allowed — set every local origin here or
# the browser handshake is rejected with 403. Next dev serves on :3000 and the QA
# harness (scripts/qa/*) on :3100, so both are listed below.
# Not a secret.
NEXORA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
# Gateway listen port for local/dev. In production the platform injects PORT,
# which takes precedence over this value. Not a secret.
MARKET_WS_PORT=8081
#
# The Gateway also reads NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (both defined above, both public) to verify
# the optional `hello` frame a signed-in browser sends. That is what lets it bound
# concurrent connections per ACCOUNT as well as per address — an address is shared
# by everybody behind a NAT and is free to rotate for anybody with a proxy pool.
#
# Both are optional for the Gateway. Without them it logs `identity verification
# disabled` at startup and bounds connections by address alone; realtime keeps
# working and public stock pages are unaffected, because a connection that never
# identifies is a fully supported connection. See
# docs/operations/edge-abuse-protection.md §4.
# Server-only admin key used by instrument sync and the server-side persistent FX cache. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Shared bearer token used only by the scheduler and /api/cron/alerts.
CRON_SECRET=
# Generate once with: npx web-push generate-vapid-keys
# Only the public key is bundled for the browser. Keep the other two server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://portkheaw.vercel.app
APP_URL=

# Server-side analytics feature flags. Analyst Consensus defaults to enabled;
# set it false only for an operational rollback.
FEATURE_TECHNICAL_INDICATORS=false
FEATURE_ADVANCED_CHART_TYPES=false
FEATURE_EXTENDED_INDICATORS=false
FEATURE_SUPPORT_RESISTANCE=false
FEATURE_KEY_STATISTICS=false
FEATURE_OPTIONS_STATISTICS=false
FEATURE_ANALYST_CONSENSUS=true

# Market Status card on the overview. Unset or false = OFF, which is the shipped
# state: the card is not reachable until an owner sets this to true, and unsetting
# it again is the rollback.
MARKET_STATUS_CARD=false

# Market Signal v2 rollout. Every phase of the rebuild ships behind one of these
# and every one of them is OFF here and in code; an unset variable is OFF too.
# Turning one on is a release decision, not a deploy step. Recommended order,
# one at a time, with a day of observation between each:
#   SIGNAL_GATE -> SIGNAL_ZONES -> SIGNAL_ACTIONABLE -> SIGNAL_CONTEXT -> SIGNAL_HISTORY
# Rollback for any phase is unsetting its variable — no revert, no migration.
SIGNAL_GATE=false
SIGNAL_ZONES=false
SIGNAL_ACTIONABLE=false
SIGNAL_CONTEXT=false
SIGNAL_HISTORY=false

# --------------------------------------------------------------------------
# Billing (Stripe). Every value below is server-only and none is NEXT_PUBLIC_.
#
# Leave BILLING_ENABLED unset and the product runs exactly as it did before paid
# plans existed: the subscription page states that payment is not open, no
# checkout control is rendered, the checkout action answers BILLING_UNAVAILABLE,
# and the webhook endpoint fails closed with 503. Nothing else is required to
# ship in that state.
#
# Provider processing requires the switch, explicit mode, credentials and return
# origin below. Price/Coupon IDs control only which plans checkout may offer, so
# webhook and portal processing remain available while checkout is off.
# --------------------------------------------------------------------------

# The explicit switch, on top of the credentials. Must be exactly "true".
BILLING_ENABLED=
# Trusted Stripe environment. Required when billing is enabled; the secret key,
# signed event.livemode, Price, Coupon and stored identities must all match it.
# Use exactly test or live. Never use legacy_unknown here.
BILLING_PROVIDER_MODE=
# New purchases are independent from webhook and portal processing. Defaults to
# off. Production Phase 4.2 may use off or internal only; do not set public.
BILLING_CHECKOUT_MODE=off
# Optional comma-separated account UUIDs admitted in internal mode. Stored admin
# role is also admitted; the browser cannot supply or override either decision.
BILLING_INTERNAL_USER_IDS=
# Where hosted checkout returns to. HTTPS only; falls back to APP_URL.
BILLING_RETURN_ORIGIN=https://portkheaw.vercel.app
# Stripe secret key. Server-only, never sent to a browser.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint registered at /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=

# Recurring price IDs, created in Stripe as THB prices on two products
# (PortKheaw Pro, PortKheaw Elite):
#   Pro   monthly    349 THB      Pro   yearly   3,490 THB
#   Elite monthly    799 THB      Elite yearly   7,990 THB
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=

# Founder's Club: a coupon with duration=once, applied on top of the ORDINARY
# annual price above — never a second, cheaper price. That is what guarantees
# the second year bills at full rate, since the subscription sits on the full
# price from day one and the discount simply stops applying.
#   Pro    first year 1,990 THB  → amount_off 1500 THB (renews 3,490)
#   Elite  first year 4,490 THB  → amount_off 3500 THB (renews 7,990)
# A Founder plan whose coupon is absent is withdrawn from sale rather than being
# offered at the undiscounted price.
STRIPE_COUPON_FOUNDER_PRO=
STRIPE_COUPON_FOUNDER_ELITE=
